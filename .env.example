# RobeWhisper 环境变量示例（复制为 .env 后按需填写；勿把真实密钥提交到仓库）

# ---------- 运行与部署 ----------
# mock = 假引擎；mujoco 或 local = MuJoCo 真引擎；remote = 日后恒定/远程引擎
ENGINE_BACKEND=mujoco
ROBOT_BACKEND=mock
LLM_BACKEND=mock

# 临时站或恒定系统访问相关（阶段 0 可不填）
# APP_HOST=127.0.0.1
# APP_PORT=8501

# ---------- 路径（相对项目根目录即可，勿写死他人电脑绝对路径） ----------
MODELS_DIR=models
EXPERIMENTS_DIR=experiments
EXPERIENCE_DIR=experience
# 相对 MODELS_DIR 的默认模型
DEFAULT_MODEL_REL=builtin_arm2/model.xml

# ---------- 超时（秒） ----------
# 仿真 run_task 墙钟上限（第 9 期步骤3）；误配 ≤0 时程序回退 30
ENGINE_TIMEOUT_SEC=30
LLM_TIMEOUT_SEC=60
ROBOT_TIMEOUT_SEC=30

# ---------- 大模型 API（阶段 3）----------
# 安全开法：先填齐下面三项，再把 LLM_BACKEND 改成 api；缺任一项会自动回退 mock，网站不崩
# LLM_BACKEND=mock|api
LLM_BACKEND=mock
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini

# ---------- 真机 / ROS（阶段 5）----------
# ROBOT_BACKEND=mock|http|ros
ROBOT_BACKEND=mock
# true 时才允许向真机口发送（仍需 backend 与地址配置齐全）
USE_REAL_ROBOT=false
ROBOT_TIMEOUT_SEC=30
# HTTP 方式：填写完整网址，例如 http://127.0.0.1:9000/execute_task
# 还没有真臂时，可另开命令窗口先跑假接收端（只测软件）：
#   python -m plugins.robot.local_fake_receiver
# ROBOT_EXECUTE_ENDPOINT=
# ROS2 方式（有实验室 ROS 环境再开）：
# ROS_DOMAIN_ID=0
# ROS_EXECUTE_TOPIC=/robewhisper/execute_task

# ---------- Real-Sim-Real（阶段 6，默认关）----------
USE_REAL_SIM_REAL=false
# RSR_CALIB_GAIN=0.5
# 第12期严模式（默认关）：true=没有合格真轨迹就跳过校准，不允许伪对照
# RSR_REQUIRE_REAL_TRAJECTORY=false

# ---------- 安全闸（第 9 期）----------
# clip=超限裁剪后执行；reject=超限直接拒绝
SAFETY_MODE=clip

# ---------- 经验分区（第 10 期）----------
# true=允许跨 model_ref 复用（仅调试）；默认 false 禁止跨臂
# EXPERIENCE_ALLOW_CROSS_MODEL=false
